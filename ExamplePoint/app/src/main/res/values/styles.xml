<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:fontFamily">@font/sora_family</item>
        <item name="fontFamily">@font/sora_family</item>
        <item name="android:windowBackground">@drawable/bg_app_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="SplashDialogTheme" parent="@android:style/Theme.Holo.Dialog">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="NavigationDrawerImage">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="NavigationDrawerBottom">
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_alignParentStart">true</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="NavigationDrawerHeaderText">
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>

    <style name="NavigationDrawerHeaderText.MainText">
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavigationDrawerHeaderText.SubText">
        <item name="android:textColor">@color/grey200</item>
    </style>

    <style name="EditTextHint" parent="@style/TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>

    <style name="EditTextErrorAppearance" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>

    <style name="EditTextColorControl">
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/white</item>
        <item name="colorControlHighlight">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="SimpleCalculatorButton">
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>

    <style name="SimpleCalculatorDeleteButton" parent="SimpleCalculatorButton">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <style name="SimpleCalculatorResetButton" parent="SimpleCalculatorButton">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/red600</item>
    </style>

    <style name="SoraNexusRegistrationInputContainer" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="hintTextColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:theme">@style/EditTextColorControl</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>

    <style name="SoraNexusRegistrationEditText" parent="@style/Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:theme">@style/EditTextColorControl</item>
        <item name="android:fontFamily">@font/sora_family</item>
    </style>
</resources>

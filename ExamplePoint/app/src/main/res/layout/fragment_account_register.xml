<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:padding="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wallet_card"
            android:orientation="vertical"
            android:padding="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:src="@drawable/reg_logo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/display_name_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/display_name"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/placeholder_account_name"
                    android:maxLength="32"
                    android:maxLines="1"
                    tools:text="Everyday Wallet" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/legal_name_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/legal_name"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/registration_legal_name_hint"
                    android:maxLines="1"
                    tools:text="Alice Nakamoto" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/document_type_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/document_type"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/registration_document_type_hint"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    tools:text="CNIC" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/document_number_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/document_number"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/registration_document_number_hint"
                    android:maxLines="1"
                    android:inputType="textCapCharacters"
                    tools:text="4210199999991" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/residency_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/residency"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/registration_residency_hint"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    tools:text="PK" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/contact_container"
                style="@style/SoraNexusRegistrationInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintTextAppearance="@style/EditTextHint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/contact"
                    style="@style/SoraNexusRegistrationEditText"
                    android:hint="@string/registration_contact_hint"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    tools:text="alice@sora.example" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/register_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_frame"
                android:padding="16dp"
                android:text="@string/register"
                android:textColor="@color/white" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
